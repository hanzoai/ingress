{
  "name": "hanzo-ingress-dashboard",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "scripts": {
    "build": "vite build",
    "build:prod": "pnpm test && pnpm tsc && pnpm lint && pnpm build",
    "dev": "vite",
    "format": "prettier './src/**/*.{ts,tsx}' --config .prettierrc.json --write",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx}'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit:ci": "vitest run"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm format",
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@traefiklabs/faency": "^12.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/web-worker": "^4.1.11",
    "chart.js": "^4.5.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^13.1.1",
    "globals": "^17.11.0",
    "jest-extended": "^7.0.0",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "msw": "^2.15.0",
    "query-string": "^9.5.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-infinite-scroll-hook": "^6.0.1",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3",
    "swr": "^2.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^1.1.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@9.15.0"
}
